rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public readable site content
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /media_print/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /media_digital/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /businesses/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /socialProfiles/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /gallery_media/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Public visitor submissions for contact form & legacy inquiries
    match /contact_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Appointment Availability (Monthly Calendar & Slot Management)
    match /appointmentAvailability/{dateId} {
      allow read: if true;
      allow create, delete: if isAuthenticated();
      // Allow update if authenticated admin OR public reserving a slot during transaction
      allow update: if isAuthenticated() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots', 'isAvailable', 'updatedAt'])
      );
    }

    // Appointment Records (Strict privacy protection)
    match /appointments/{bookingId} {
      // Public visitors can submit verified appointments
      allow create: if true;
      // Only authenticated admins can browse, view details, mark completed or cancel
      allow read, update, delete: if isAuthenticated();
    }

    // Site Statistics & Professional Visitor Counter
    match /siteStats/{docId} {
      allow read: if true;
      // Allow document creation only when initialized with the baseline 454895
      allow create: if request.resource.data.count == 454895;
      // Allow update if incrementing by 1 and only modifying count and updatedAt
      allow update: if isAuthenticated() || (
        request.resource.data.count == resource.data.count + 1 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt'])
      );
      allow delete: if isAuthenticated();
    }

    // System migration status & bootstrap configuration
    match /system/{docId} {
      allow read: if true;
      allow write: if true; // Allows initial one-time seed migration from frontend
    }

    // Admin role allowlist
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

